{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "globals": {
    "__NOVA_BUILD__": "readonly"
  },
  "overrides": [
    {
      "files": [
        "widgets/**"
      ],
      "rules": {
        "no-undef": "off"
      }
    }
  ]
}
