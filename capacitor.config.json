{
  "appId": "com.haydencooper.novaos",
  "appName": "Nova OS",
  "webDir": "dist",
  "server": {
    "url": "https://hcooper12.github.io/nova-os/",
    "cleartext": false
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0a0f1e",
    "preferredContentMode": "mobile",
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    }
  }
}
